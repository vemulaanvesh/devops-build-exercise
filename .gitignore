# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment
.env
.env.*
!.env.example

# Editors
.vscode/
.idea/
*.swp
.DS_Store

# Terraform
*.tfstate
*.tfstate.*
.terraform/
crash.log
# Allow .terraform.lock.hcl: it pins providers and SHOULD be committed.
!.terraform.lock.hcl
# Don't commit real tfvars (use *.example as the committed template).
*.tfvars
!*.tfvars.example
# Plan artifacts
tfplan
plan.txt
# Local-only test overrides for plan-against-sandbox flows
*_override.tf
terraform.local.tfstate*

# Local data
*.db
*.sqlite

# Local-only working copies of design/ops notes and generated assets;
# not part of the submission.
docs/
assets/
path/to/

